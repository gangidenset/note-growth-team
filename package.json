{
  "name": "note-growth-team",
  "version": "0.1.0",
  "private": true,
  "description": "note収益化AI社員システム（状態管理CLIと検証）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run secret-scan && npm run data:check",
    "article:new": "tsx src/cli/index.ts article:new",
    "article:transition": "tsx src/cli/index.ts article:transition",
    "article:status": "tsx src/cli/index.ts article:status",
    "article:archive": "tsx src/cli/index.ts article:archive",
    "market:validate": "tsx src/cli/index.ts market:validate",
    "data:check": "tsx src/cli/index.ts data:check",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "demo:setup": "tsx scripts/demo-setup.ts",
    "approve": "tsx src/cli/index.ts approve",
    "publish:record": "tsx src/cli/index.ts publish:record"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
