# .env.example — 環境変数のひな形（実際の値は書かない）
# 使い方: cp .env.example .env して、.env に自分の値を入力する。
# .env は .gitignore で除外されており、Git に登録されません。

# Anthropic API キー（APIキー従量課金で使う場合のみ。サブスクリプション利用なら不要）
ANTHROPIC_API_KEY=your-api-key-here

# 承認者名（承認記録に残る名前）
NGT_APPROVER_NAME=owner

# 月間API予算の上限（円）。これを超えそうな処理は実行前に確認する
NGT_MONTHLY_BUDGET_JPY=10000

# 売上目標（円/月）
NGT_MONTHLY_REVENUE_TARGET_JPY=50000

# タイムゾーン（retrieved_at の記録に使用）
TZ=Asia/Tokyo
